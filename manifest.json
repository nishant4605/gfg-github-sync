{
  "manifest_version": 3,
  "name": "GeekSync – GeeksforGeeks to GitHub, with Streak & Stats",
  "short_name": "GeekSync",
  "version": "0.1.0",
  "description": "Auto-push accepted GeeksforGeeks solutions to GitHub with a stats README: streak, rank, score, badges. Not affiliated with GFG.",
  "homepage_url": "https://github.com/nishant4605/gfg-github-sync",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.geeksforgeeks.org/*",
    "https://api.github.com/*",
    "https://github.com/login/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.geeksforgeeks.org/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.geeksforgeeks.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GeekSync"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
